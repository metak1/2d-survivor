# systemd unit for running the game server without Docker.
#   sudo cp deploy/nightfall-bastion.service /etc/systemd/system/
#   sudo systemctl enable --now nightfall-bastion
# Adjust User and WorkingDirectory to where you built the game (npm ci && npm run build).

[Unit]
Description=Nightfall Bastion game server
After=network.target

[Service]
User=nightfall
WorkingDirectory=/opt/nightfall-bastion
Environment=NODE_ENV=production PORT=3000 HOST=127.0.0.1
ExecStart=/usr/bin/node dist-server/main.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
